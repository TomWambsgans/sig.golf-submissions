namespace FetchFromMatch
open SigGolf SigGolf.Riscv RiscvZkvm.Rv64

theorem fetch_code (image : Image) (state : MachineState) (pc : BitVec 64)
    (index : Nat)
    (hpc : state.pc = pc)
    (hbase : 0x1000 ≤ pc.toNat) (halign : pc.toNat % 4 = 0)
    (hindex : (pc.toNat - 0x1000) / 4 = index) :
    fetch image state = (image.code[index]?).bind decodeInstruction := by
  have hnot : ¬ pc.toNat < 0x1000 := Nat.not_lt.mpr hbase
  simp [fetch, hpc, hnot, halign, hindex]

theorem fetch_stub_of_match (image : Image) (site : StubSiteTable.Site)
    (hmatch : site.Matches image) (j : Fin site.stubWords.length)
    (state : MachineState) (hpc : state.pc = BitVec.ofNat 64 (site.stubPC + 4 * j.val))
    (hbase : 0x1000 ≤ (BitVec.ofNat 64 (site.stubPC + 4 * j.val)).toNat)
    (halign : (BitVec.ofNat 64 (site.stubPC + 4 * j.val)).toNat % 4 = 0)
    (hindex : ((BitVec.ofNat 64 (site.stubPC + 4 * j.val)).toNat - 0x1000) / 4 =
      (site.stubPC - 0x1000) / 4 + j.val) :
    fetch image state = (site.stubWords[j.val]?).bind decodeInstruction := by
  rw [fetch_code image state _ _ hpc hbase halign hindex, hmatch.2 j]

end FetchFromMatch
