namespace StubMacro
open SigGolf SigGolf.Riscv RiscvZkvm.Rv64 OracleComp

/-- The query that the pre-beta bytecode intended to make, with `a1` in bits. -/
def oldHashInput (state : MachineState) : Query :=
  let n := (state.getReg .x11).toNat
  ⟨n, BitVec.ofNat n ((List.range n).foldl (fun acc i =>
    acc + if (state.getByte (state.getReg .x10 + BitVec.ofNat 64 (i / 8))).getLsbD (i % 8)
      then 2 ^ i else 0) 0)⟩

/-- RV64's SRLI by 3 is exact division by eight on the unsigned length. -/
theorem shift_length (length : BitVec 64) :
    length >>> 3 = BitVec.ofNat 64 (length.toNat / 8) := by
  apply BitVec.eq_of_toNat_eq
  rw [BitVec.toNat_ushiftRight]
  simp [Nat.shiftRight_eq_div_pow, BitVec.toNat_ofNat]
  have bound := BitVec.isLt length
  omega

/-- The new byte-length HASH query is the old bit-length query. -/
theorem hashInput_shift (state : MachineState)
    (hdiv : (state.getReg .x11).toNat % 8 = 0) :
    SigGolf.Riscv.hashInput
      (state.setReg .x11 (state.getReg .x11 >>> 3)) = oldHashInput state := by
  have hq : (state.getReg .x11).toNat / 8 < 2 ^ 64 := by
    have h := BitVec.isLt (state.getReg .x11)
    omega
  have hget11 :
      (state.setReg .x11 (state.getReg .x11 >>> 3)).getReg .x11 =
        BitVec.ofNat 64 ((state.getReg .x11).toNat / 8) := by
    rw [MachineState.getReg_setReg_eq (by decide), shift_length]
  have hget10 :
      (state.setReg .x11 (state.getReg .x11 >>> 3)).getReg .x10 =
        state.getReg .x10 := by
    exact MachineState.getReg_setReg_ne state .x11 .x10 _ (by decide)
  have hbyte (address : BitVec 64) :
      (state.setReg .x11 (state.getReg .x11 >>> 3)).getByte address =
        state.getByte address := by simp only [MachineState.getByte, MachineState.getMem_setReg]
  have hto : (BitVec.ofNat 64 ((state.getReg .x11).toNat / 8)).toNat =
      (state.getReg .x11).toNat / 8 := by
    simp [BitVec.toNat_ofNat]
    exact hq
  unfold SigGolf.Riscv.hashInput oldHashInput
  rw [hget11, hget10, hto]
  simp only [hbyte]
  have hmul : 8 * ((state.getReg .x11).toNat / 8) = (state.getReg .x11).toNat := by omega
  rw [hmul]

/-- The same shift restores the old bit length when it was a whole number of bytes. -/
theorem shift_length_roundtrip (length : BitVec 64)
    (hdiv : length.toNat % 8 = 0) :
    (length >>> 3) <<< 3 = length := by
  apply BitVec.eq_of_toNat_eq
  rw [BitVec.toNat_shiftLeft, BitVec.toNat_ushiftRight]
  simp only [Nat.shiftRight_eq_div_pow, Nat.shiftLeft_eq]
  have bound := BitVec.isLt length
  omega

/-- The translated JAL does not change registers or memory. -/
theorem jump_step (state : MachineState) (offset : BitVec 21) :
    ordinaryStep state (.base (.JAL .x0 offset)) =
      some (state.setPC (state.pc + signExtend21 offset)) := by
  simp [ordinaryStep, memoryArgumentsValid, execInstrBr, MachineState.setReg]

theorem shift_step (state : MachineState) :
    ordinaryStep state (.base (.SRLI .x11 .x11 3)) =
      some ((state.setReg .x11 (state.getReg .x11 >>> 3)).setPC (state.pc + 4)) := by
  simp [ordinaryStep, memoryArgumentsValid, execInstrBr]

theorem select_hash_step (state : MachineState) :
    ordinaryStep state (.base (.ADDI .x5 .x0 0)) =
      some ((state.setReg .x5 0).setPC (state.pc + 4)) := by
  simp [ordinaryStep, memoryArgumentsValid, execInstrBr, MachineState.getReg, signExtend12]

theorem restore_length_step (state : MachineState) :
    ordinaryStep state (.base (.SLLI .x11 .x11 3)) =
      some ((state.setReg .x11 (state.getReg .x11 <<< 3)).setPC (state.pc + 4)) := by
  simp [ordinaryStep, memoryArgumentsValid, execInstrBr]

theorem restore_selector_step (state : MachineState) :
    ordinaryStep state (.base (.ADDI .x5 .x0 1)) =
      some ((state.setReg .x5 1).setPC (state.pc + 4)) := by
  simp [ordinaryStep, memoryArgumentsValid, execInstrBr, MachineState.getReg, signExtend12]

theorem invert_exit_step (state : MachineState) :
    ordinaryStep state (.base (.XORI .x10 .x10 1)) =
      some ((state.setReg .x10 (state.getReg .x10 ^^^ 1)).setPC (state.pc + 4)) := by
  simp [ordinaryStep, memoryArgumentsValid, execInstrBr, signExtend12]

def shifted (state : MachineState) (stubPC : BitVec 64) : MachineState :=
  ((state.setPC stubPC).setReg .x11 (state.getReg .x11 >>> 3)).setPC (stubPC + 4)

def hashReady (state : MachineState) (stubPC : BitVec 64) : MachineState :=
  ((shifted state stubPC).setReg .x5 0).setPC ((shifted state stubPC).pc + 4)

theorem shifted_step (state : MachineState) (stubPC : BitVec 64) :
    ordinaryStep (state.setPC stubPC) (.base (.SRLI .x11 .x11 3)) =
      some (shifted state stubPC) := by
  rw [shift_step]
  simp [shifted, MachineState.getReg, MachineState.setPC]

theorem ready_step (state : MachineState) (stubPC : BitVec 64) :
    ordinaryStep (shifted state stubPC) (.base (.ADDI .x5 .x0 0)) =
      some (hashReady state stubPC) := by
  rw [select_hash_step]
  rfl

theorem hashReady_query (state : MachineState) (stubPC : BitVec 64)
    (hdiv : (state.getReg .x11).toNat % 8 = 0) :
    hashInput (hashReady state stubPC) = oldHashInput state := by
  have query := hashInput_shift state hdiv
  simpa [hashReady, shifted, hashInput, MachineState.getByte, MachineState.getMem,
    MachineState.setPC, MachineState.setReg, MachineState.getReg] using query

theorem hashReady_selector (state : MachineState) (stubPC : BitVec 64) :
    (hashReady state stubPC).getReg .x5 = 0 := by
  simp [hashReady, shifted, MachineState.getReg_setPC,
    MachineState.getReg_setReg_eq]

theorem hash_ecall_eval (hash : Hash) (image : Image) (state : MachineState)
    (stubPC : BitVec 64) (fuel : Nat)
    (hdiv : (state.getReg .x11).toNat % 8 = 0)
    (fetched : fetch image (hashReady state stubPC) = some (.base .ECALL))
    (valid : hashArgumentsValid (hashReady state stubPC) = true) :
    evalWithAnswerFn hash
      (execute (fuel + 1) image (hashReady state stubPC)) =
      (evalWithAnswerFn hash
        (execute fuel image (writeHash (hashReady state stubPC)
          (hash (oldHashInput state))))).charge
        (8 * compressions (oldHashInput state).1) 1
        (compressions (oldHashInput state).1) := by
  have answer : evalWithAnswerFn hash
      (liftM (HashSpec.query (hashInput (hashReady state stubPC)))) =
      hash (hashInput (hashReady state stubPC)) := by
    simp [evalWithAnswerFn]
  simp [execute, fetched, hashReady_selector, valid,
    hashReady_query state stubPC hdiv, answer]
  rw [hashReady_query state stubPC hdiv]

theorem ordinary_eval (hash : Hash) (image : Image) (state next : MachineState)
    (instruction : Instruction) (fuel : Nat)
    (fetched : fetch image state = some instruction)
    (notHash : instruction ≠ .base .ECALL)
    (stepped : ordinaryStep state instruction = some next) :
    evalWithAnswerFn hash (execute (fuel + 1) image state) =
      (evalWithAnswerFn hash (execute fuel image next)).charge
        (instructionCycles instruction) 0 0 := by
  cases instruction with
  | base baseInstruction =>
    cases baseInstruction <;> simp_all [execute]
  | word op rd rs1 rs2 =>
    simp [execute, fetched, stepped]
  | sraiw rd rs shift =>
    simp [execute, fetched, stepped]

/-- The current beta executor rejects the common 480-bit/60-byte old query. -/
theorem hashReady_invalid_60 (state : MachineState) (stubPC : BitVec 64)
    (hbits : state.getReg .x11 = 480) :
    hashArgumentsValid (hashReady state stubPC) = false := by
  have hb : state.regs .x11 = 480 := by simpa [MachineState.getReg] using hbits
  simp [hashArgumentsValid, hashReady, shifted,
    MachineState.setReg, MachineState.setPC, MachineState.getReg, hb]

def hashBoundary (state : MachineState) (stubPC : BitVec 64)
    (answer : BitVec 256) : MachineState :=
  let hashed := writeHash (hashReady state stubPC) answer
  let lengthRestored :=
    (hashed.setReg .x11 (hashed.getReg .x11 <<< 3)).setPC (hashed.pc + 4)
  let selectorRestored :=
    (lengthRestored.setReg .x5 1).setPC (lengthRestored.pc + 4)
  selectorRestored.setPC (state.pc + 4)

def hashedAtStub (state : MachineState) (stubPC : BitVec 64)
    (answer : BitVec 256) : MachineState :=
  writeHash (hashReady state stubPC) answer

def lengthRestored (state : MachineState) (stubPC : BitVec 64)
    (answer : BitVec 256) : MachineState :=
  let hashed := hashedAtStub state stubPC answer
  (hashed.setReg .x11 (hashed.getReg .x11 <<< 3)).setPC (hashed.pc + 4)

def selectorRestored (state : MachineState) (stubPC : BitVec 64)
    (answer : BitVec 256) : MachineState :=
  let restored := lengthRestored state stubPC answer
  (restored.setReg .x5 1).setPC (restored.pc + 4)

theorem length_restore_step (state : MachineState) (stubPC : BitVec 64)
    (answer : BitVec 256) :
    ordinaryStep (hashedAtStub state stubPC answer) (.base (.SLLI .x11 .x11 3)) =
      some (lengthRestored state stubPC answer) := by
  rw [restore_length_step]
  rfl

theorem selector_restore_step (state : MachineState) (stubPC : BitVec 64)
    (answer : BitVec 256) :
    ordinaryStep (lengthRestored state stubPC answer) (.base (.ADDI .x5 .x0 1)) =
      some (selectorRestored state stubPC answer) := by
  rw [restore_selector_step]
  rfl

theorem return_jump_step (state : MachineState) (stubPC : BitVec 64)
    (answer : BitVec 256) (returnOffset : BitVec 21)
    (target : (selectorRestored state stubPC answer).pc +
      signExtend21 returnOffset = state.pc + 4) :
    ordinaryStep (selectorRestored state stubPC answer)
      (.base (.JAL .x0 returnOffset)) =
        some (hashBoundary state stubPC answer) := by
  rw [jump_step, target]
  rfl

/-- Candidate post-HASH boundary equality, conditional on current beta admitting the query. -/
theorem hashBoundary_eq (state : MachineState) (stubPC : BitVec 64)
    (answer : BitVec 256)
    (hselector : state.getReg .x5 = 1)
    (hdiv : (state.getReg .x11).toNat % 8 = 0) :
    hashBoundary state stubPC answer = writeHash state answer := by
  have hlen : (state.regs .x11 >>> 3) <<< 3 = state.regs .x11 := by
    simpa [MachineState.getReg] using
      (shift_length_roundtrip (state.getReg .x11) hdiv)
  have hsel : state.regs .x5 = 1 := by
    simpa [MachineState.getReg] using hselector
  unfold hashBoundary hashReady shifted writeHash
  simp [MachineState.writeWords, MachineState.setMem, MachineState.setReg,
    MachineState.setPC, MachineState.getReg]
  funext r
  cases r <;> simp [hlen, hsel]

/-- Seven current-beta instructions implement one legacy HASH and return to
    exactly its old post-HASH state; only six ordinary cycles are added. -/
theorem beta_hash_stub_macro (hash : Hash) (image : Image) (state : MachineState)
    (stubPC : BitVec 64) (forward back : BitVec 21) (fuel : Nat)
    (hselector : state.getReg .x5 = 1)
    (hdiv : (state.getReg .x11).toNat % 8 = 0)
    (hforward : state.pc + signExtend21 forward = stubPC)
    (hback : (selectorRestored state stubPC (hash (oldHashInput state))).pc +
      signExtend21 back = state.pc + 4)
    (f0 : fetch image state = some (.base (.JAL .x0 forward)))
    (f1 : fetch image (state.setPC stubPC) = some (.base (.SRLI .x11 .x11 3)))
    (f2 : fetch image (shifted state stubPC) = some (.base (.ADDI .x5 .x0 0)))
    (f3 : fetch image (hashReady state stubPC) = some (.base .ECALL))
    (f4 : fetch image (hashedAtStub state stubPC (hash (oldHashInput state))) =
      some (.base (.SLLI .x11 .x11 3)))
    (f5 : fetch image (lengthRestored state stubPC (hash (oldHashInput state))) =
      some (.base (.ADDI .x5 .x0 1)))
    (f6 : fetch image (selectorRestored state stubPC (hash (oldHashInput state))) =
      some (.base (.JAL .x0 back)))
    (valid : hashArgumentsValid (hashReady state stubPC) = true) :
    evalWithAnswerFn hash (execute (fuel + 7) image state) =
      (evalWithAnswerFn hash
        (execute fuel image (writeHash state (hash (oldHashInput state))))).charge
        (6 + 8 * compressions (oldHashInput state).1) 1
        (compressions (oldHashInput state).1) := by
  have s0 : ordinaryStep state (.base (.JAL .x0 forward)) =
      some (state.setPC stubPC) := by rw [jump_step, hforward]
  have s6 : ordinaryStep
      (selectorRestored state stubPC (hash (oldHashInput state)))
      (.base (.JAL .x0 back)) =
      some (hashBoundary state stubPC (hash (oldHashInput state))) :=
    return_jump_step state stubPC _ back hback
  rw [show fuel + 7 = (fuel + 6) + 1 by omega]
  rw [ordinary_eval hash image state (state.setPC stubPC)
    (.base (.JAL .x0 forward)) (fuel + 6) f0 (by simp) s0]
  rw [show fuel + 6 = (fuel + 5) + 1 by omega]
  rw [ordinary_eval hash image (state.setPC stubPC) (shifted state stubPC)
    (.base (.SRLI .x11 .x11 3)) (fuel + 5) f1 (by simp)
    (shifted_step state stubPC)]
  rw [show fuel + 5 = (fuel + 4) + 1 by omega]
  rw [ordinary_eval hash image (shifted state stubPC) (hashReady state stubPC)
    (.base (.ADDI .x5 .x0 0)) (fuel + 4) f2 (by simp)
    (ready_step state stubPC)]
  rw [show fuel + 4 = (fuel + 3) + 1 by omega]
  rw [hash_ecall_eval hash image state stubPC (fuel + 3) hdiv f3 valid]
  rw [show fuel + 3 = (fuel + 2) + 1 by omega]
  rw [ordinary_eval hash image
    (writeHash (hashReady state stubPC) (hash (oldHashInput state)))
    (lengthRestored state stubPC (hash (oldHashInput state)))
    (.base (.SLLI .x11 .x11 3)) (fuel + 2) f4 (by simp)
    (length_restore_step state stubPC _)]
  rw [show fuel + 2 = (fuel + 1) + 1 by omega]
  rw [ordinary_eval hash image
    (lengthRestored state stubPC (hash (oldHashInput state)))
    (selectorRestored state stubPC (hash (oldHashInput state)))
    (.base (.ADDI .x5 .x0 1)) (fuel + 1) f5 (by simp)
    (selector_restore_step state stubPC _)]
  rw [ordinary_eval hash image
    (selectorRestored state stubPC (hash (oldHashInput state)))
    (hashBoundary state stubPC (hash (oldHashInput state)))
    (.base (.JAL .x0 back)) fuel f6 (by simp) s6]
  rw [hashBoundary_eq state stubPC _ hselector hdiv]
  simp [Execution.charge, instructionCycles]
  omega

/-- info: 'StubMacro.hashInput_shift' depends on axioms: [propext, Quot.sound] -/
#guard_msgs in
#print axioms hashInput_shift

/-- info: 'StubMacro.hashBoundary_eq' depends on axioms: [propext, Quot.sound] -/
#guard_msgs in
#print axioms hashBoundary_eq

/-- info: 'StubMacro.hashReady_invalid_60' depends on axioms: [propext, Quot.sound] -/
#guard_msgs in
#print axioms hashReady_invalid_60

/-- info: 'StubMacro.beta_hash_stub_macro' depends on axioms: [propext, Quot.sound] -/
#guard_msgs in
#print axioms beta_hash_stub_macro

end StubMacro
