namespace StubSiteTable

structure Site where
  oldPC : Nat
  stubPC : Nat
  replacement : BitVec 32
  stubWords : List (BitVec 32)
  oldBits : Nat := 0  -- zero denotes HALT
  deriving Repr, Inhabited

def Site.Matches (image : SigGolf.Riscv.Image) (site : Site) : Prop :=
  image.code[(site.oldPC - 0x1000) / 4]? = some site.replacement ∧
  ∀ j : Fin site.stubWords.length,
    image.code[(site.stubPC - 0x1000) / 4 + j.val]? = site.stubWords[j.val]?

