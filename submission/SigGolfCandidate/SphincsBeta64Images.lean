  returns : stubPC + 76 + signExtend21 jump = oldPC + 4

private theorem Site.fetchAt (site : Site) (s : MachineState) (j : Nat)
    (inside : j < 20)
    (pc : s.pc.toNat = site.stubPC.toNat + 4 * j)
