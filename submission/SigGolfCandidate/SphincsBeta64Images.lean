theorem verify_12a0_transport (hash : Hash) (fuel : Nat)
    (s : MachineState)
    (oldPc : s.pc = 0x12a0)
    (source : s.getReg .x10 = 0x40000)
    (length : s.getReg .x11 = 896)
    (destination : s.getReg .x12 = 0x42000)
    (selector : s.getReg .x5 = 1)
