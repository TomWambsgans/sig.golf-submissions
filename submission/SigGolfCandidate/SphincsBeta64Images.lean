    exact scratch pair.1 (List.mem_map.mpr ⟨pair, h, rfl⟩)
  · intro pair h
    simp [cells72] at h
    rcases h with rfl | rfl | rfl | rfl | rfl | rfl | rfl
    all_goals decide
  · intro pair h
    simp [cells72] at h
    rcases h with rfl | rfl | rfl | rfl | rfl | rfl | rfl
    all_goals simp [destination]

