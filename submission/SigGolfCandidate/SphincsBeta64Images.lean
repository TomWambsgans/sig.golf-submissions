namespace Candidate64
open SigGolf SigGolf.Riscv

def sizes : Sizes := ⟨11324, 11324⟩
def layout : Layout := Riscv.standardLayout sizes

def submission : Submission where
  sizes := sizes
  layout := layout
  image
    | .keygen => Pc64KeygenImage.image
    | .sign => Pc64SignImage.image
    | .expand => Pc64ExpandImage.image
    | .verify => Pc64VerifyImage.image

theorem sizes_valid : sizes.Valid := by
  norm_num [Sizes.Valid, sizes, MAX_WITNESS_BYTES]

private theorem layout_valid_of_empty (image : Image) (empty : image.data = []) :
    Riscv.layoutValid layout sizes image := by
  simp [Riscv.layoutValid, Riscv.dataBase, empty, layout, sizes,
    Riscv.layoutBuffers, Riscv.buffersDisjoint, Riscv.disjointBuffers,
    Riscv.standardLayout]
  norm_num [MEMORY_BYTES, CACHE_BYTES, Riscv.signatureBase, Riscv.witnessBase]

theorem admissible : submission.Admissible := by
  constructor
  · exact sizes_valid
  · intro phase
    cases phase <;> constructor
    · change Pc64KeygenImage.image.byteSize < MAX_IMAGE_BYTES
      rw [Pc64KeygenImage.image_byteSize]
      decide
    · exact layout_valid_of_empty _ Pc64KeygenImage.image_data_empty
    · change Pc64SignImage.image.byteSize < MAX_IMAGE_BYTES
      rw [Pc64SignImage.image_byteSize]
      decide
    · exact layout_valid_of_empty _ Pc64SignImage.image_data_empty
    · change Pc64ExpandImage.image.byteSize < MAX_IMAGE_BYTES
      rw [Pc64ExpandImage.image_byteSize]
      decide
    · exact layout_valid_of_empty _ Pc64ExpandImage.image_data_empty
    · change Pc64VerifyImage.image.byteSize < MAX_IMAGE_BYTES
      rw [Pc64VerifyImage.image_byteSize]
      decide
    · exact layout_valid_of_empty _ Pc64VerifyImage.image_data_empty

#print axioms admissible
end Candidate64
