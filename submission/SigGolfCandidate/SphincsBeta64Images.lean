    have h := site.bound
    bv_omega
  have pc6 : s6.pc.toNat = site.stubPC.toNat + 24 := by
    simp [s6, MachineState.setPC]
    have h := site.bound
    bv_omega
  have hshift : ordinaryStep p (.base (.SRLI .x11 .x11 3)) = some s5 := by
