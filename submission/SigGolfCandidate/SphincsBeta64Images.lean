    let u2 := (u1.setReg .x11 (u1.getReg .x11 <<< 3)).setPC (u1.pc + 4)
    let u3 := (u2.setReg .x5 1).setPC (u2.pc + 4)
    Padding64Trace.OrdinaryTrace site.image 3 s u3 := by
