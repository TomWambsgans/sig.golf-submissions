theorem queryBytes_pad72 (s : MachineState)
    (source : s.getReg .x10 = 0x40000) :
    SphincsSecurity.bytesLE (64 * ((hashInput (ready72 s)).1 + 1))
      (hashInput (ready72 s)).2 =
      (List.range 72).map (fun i => UInt8.ofBitVec
